#!/usr/bin/env python3
"""Alt+Tab: every window in a walker list (workspace · app · title), most recently
focused first; Enter jumps to it, including into a scratchpad."""
import json
import subprocess

clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout)
# focusHistoryID 0 is the focused window; start the list at the one before it, like Alt+Tab
clients = [c for c in clients if c["mapped"] and c["class"]]
clients.sort(key=lambda c: c["focusHistoryID"])
if len(clients) > 1:
    clients = clients[1:] + clients[:1]

lines, by_line = [], {}
for c in clients:
    ws = c["workspace"]["name"].replace("special:", "★ ")
    line = f"{ws:>8} · {c['class']} · {c['title'][:80]}"
    lines.append(line)
    by_line[line] = c["address"]

pick = subprocess.run(["walker", "--dmenu", "-p", "windows"], input="\n".join(lines),
                      capture_output=True, text=True).stdout.strip()
addr = by_line.get(pick)
if addr:
    subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
                   capture_output=True)
