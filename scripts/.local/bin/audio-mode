#!/usr/bin/env bash
# Switch between the hand-built PipeWire setup and OpenXLR. They both create
# channel sinks and move app streams, so only one may be active at a time.
#
#   audio-mode            show the active mode
#   audio-mode legacy     virtual sinks + find-user-target.lua + output priority
#   audio-mode openxlr    OpenXLR daemon owns channels, routing and the Wave XLR
#
# The legacy files live in ~/dotfiles/audio/legacy/ (not stowed): legacy mode copies
# them into place, OpenXLR mode removes the copies.
set -euo pipefail

LEGACY_SRC="$HOME/dotfiles/audio/legacy"
LEGACY_FILES=(
    "$HOME/.config/pipewire/pipewire.conf.d/virtual-sinks.conf"
    "$HOME/.config/wireplumber/wireplumber.conf.d/50-app-routing.conf"
    "$HOME/.config/wireplumber/wireplumber.conf.d/52-output-priority.conf"
)

current() {
    if [ -f "${LEGACY_FILES[0]}" ]; then echo legacy; else echo openxlr; fi
}

restart_audio() {
    systemctl --user restart wireplumber pipewire pipewire-pulse
    sleep 3
    # Restarting PipeWire can wedge the Wave XLR capture PCM; bounce it.
    systemctl --user start wave-xlr-recover.service || true
}

to_openxlr() {
    rm -f "${LEGACY_FILES[@]}"
    restart_audio
    systemctl --user enable --now openxlr-daemon.service
}

to_legacy() {
    systemctl --user disable --now openxlr-daemon.service 2>/dev/null || true
    for f in "${LEGACY_FILES[@]}"; do
        mkdir -p "$(dirname "$f")"
        cp "$LEGACY_SRC/$(basename "$f")" "$f"
    done
    restart_audio
    wpctl clear-default 2>/dev/null || true
}

case "${1:-}" in
    "")      echo "audio mode: $(current)" ;;
    openxlr) [ "$(current)" = openxlr ] && { echo "already openxlr"; exit 0; }; to_openxlr; echo "audio mode: openxlr" ;;
    legacy)  [ "$(current)" = legacy ]  && { echo "already legacy";  exit 0; }; to_legacy;  echo "audio mode: legacy" ;;
    *)       echo "usage: audio-mode [legacy|openxlr]" >&2; exit 2 ;;
esac
