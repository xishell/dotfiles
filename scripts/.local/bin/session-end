#!/bin/sh
# Reboot / power off / log out, after quitting apps that only save state on a clean exit.
#
# Vesktop: Discord keeps its login token in memory and writes it back to storage only
# when the page closes. On reboot systemd stops the app's whole scope at once, so the
# page process dies before that happens and Discord asks for a login after every
# restart. SIGTERM to the main process alone makes Electron quit normally instead.
#
#   session-end apps       only quit those apps (Super+M runs this before hyprshutdown)
#   session-end reboot | poweroff | logout
set -u

# SIGTERM the oldest process whose command line starts with $1; wait up to 10 s for it
quit_main() {
    pid=$(pgrep -o -f "^$1") || return 0
    kill -TERM "$pid" 2>/dev/null || return 0
    i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 40 ]; do
        sleep 0.25
        i=$((i + 1))
    done
}

quit_main /usr/lib/vesktop/vesktop

case "${1:-}" in
apps)     ;;
reboot)   exec systemctl reboot ;;
poweroff) exec systemctl poweroff ;;
logout)   exec uwsm stop ;;
*)        echo "usage: session-end apps|reboot|poweroff|logout" >&2; exit 2 ;;
esac
