#!/usr/bin/env python3
"""Ironbar stat modules for the Ember rice: ember-bar cpu|gpu|mem|vol|net|pad

Each runs forever (ironbar `script` module, mode = "watch") and prints one line of
Pango markup per update: a Nerd Font icon in its fixed label colour, then the value,
which turns yellow at the warning level and red at the critical level. Ironbar's
classes are static, so the level colour has to travel in the markup.
"""
import os
import subprocess
import sys
import time

# ember:begin
# generated by theme/gen from theme/palette.toml (template: theme/templates/scripts/ember-bar.py); edit those, not this
YELLOW = "#e6b673"
RED = "#f2798c"
GREEN = "#a7c97a"
CYAN = "#86c9e0"
BLUE = "#82a1e6"
TEAL = "#7cc7b2"
MAGENTA = "#c49ae8"
COMMENT = "#938a9b"
# ember:end

ICON = '<span font_family="Symbols Nerd Font" size="12.5pt" rise="-1pt" color="{color}">{glyph}</span>'


def show(glyph, icon_color, value, level=0, value_color=None):
    color = value_color or (RED if level == 2 else YELLOW if level == 1 else None)
    text = f'<span color="{color}" weight="bold">{value}</span>' if color else value
    print(ICON.format(color=icon_color, glyph=glyph) + (f" {text}" if text else ""), flush=True)


def level(v, warn, crit):
    return 2 if v >= crit else 1 if v >= warn else 0


def cpu():
    def sample():
        with open("/proc/stat") as f:
            vals = list(map(int, f.readline().split()[1:]))
        return vals[3] + vals[4], sum(vals)  # idle + iowait, total
    idle0, total0 = sample()
    while True:
        time.sleep(2)
        idle1, total1 = sample()
        pct = 100 * (1 - (idle1 - idle0) / max(total1 - total0, 1))
        idle0, total0 = idle1, total1
        show("\U000f0ee0", YELLOW, f"{pct:.0f}%", level(pct, 80, 95))


def gpu():
    # nvidia-smi's own loop keeps one process alive instead of forking every tick
    p = subprocess.Popen(["nvidia-smi", "--query-gpu=temperature.gpu", "--format=csv,noheader,nounits",
                          "--loop-ms=3000"], stdout=subprocess.PIPE, text=True)
    for line in p.stdout:
        t = int(line.strip() or 0)
        show("\U000f08ae", GREEN, f"{t}°", level(t, 80, 85))


def mem():
    while True:
        info = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":", 1)
                info[k] = int(v.split()[0])
        used = info["MemTotal"] - info["MemAvailable"]
        pct = 100 * used / info["MemTotal"]
        show("\U000f035b", CYAN, f"{used / 1048576:.1f}G", level(pct, 80, 95))
        time.sleep(5)


def vol():
    def emit():
        out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True).stdout
        parts = out.split()  # "Volume: 0.62" or "Volume: 0.62 [MUTED]"
        if len(parts) < 2:
            return
        if "[MUTED]" in out:
            show("\U000f0581", COMMENT, "muted", value_color=COMMENT)
        else:
            show("\U000f057e", MAGENTA, f"{float(parts[1]) * 100:.0f}%")
    emit()
    # Re-read on every sink/server change (volume keys, mixer, default sink switch)
    p = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True)
    for line in p.stdout:
        if "sink" in line or "server" in line:
            emit()


def default_iface():
    with open("/proc/net/route") as f:
        for line in f.readlines()[1:]:
            parts = line.split()
            if parts[1] == "00000000":
                return parts[0]
    return None


def net():
    while True:
        iface = default_iface()
        state = open(f"/sys/class/net/{iface}/operstate").read().strip() if iface else "down"
        if state == "up":
            show("\U000f0200", BLUE, "")
        else:
            show("\U000f0319", RED, "offline", value_color=RED)
        time.sleep(5)


def pad():
    # Xbox-protocol pads (xone/gip) report a battery level, not a percentage
    path = "/sys/class/power_supply/gip0.0/capacity_level"
    while True:
        try:
            lvl = open(path).read().strip().lower()
        except OSError:
            lvl = None
        if lvl is None:
            print("", flush=True)
        else:
            show("\U000f0297", TEAL, lvl, {"low": 1, "critical": 2}.get(lvl, 0))
        time.sleep(10)


if __name__ == "__main__":
    try:
        {"cpu": cpu, "gpu": gpu, "mem": mem, "vol": vol, "net": net, "pad": pad}[sys.argv[1]]()
    except (BrokenPipeError, KeyboardInterrupt):
        # ironbar closed the pipe (bar reload/exit); leave without a traceback
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
