#!/usr/bin/env python3
"""Ironbar modules for the Hearth rice: ember-bar cpu|gpu|mem|vol|net|pad|media
(plus `ember-bar vol-step up|down|mute`, the volume chip's scroll/click actions)

Each runs forever (ironbar `script` module, mode = "watch") and prints one line of
Pango markup per update: a Nerd Font icon in its fixed label colour, then the value,
which turns yellow at the warning level and red at the critical level. Ironbar's
classes are static, so the level colour has to travel in the markup.
"""
import html
import json
import os
import re
import selectors
import subprocess
import sys
import time

# ember:begin
# generated by theme/gen from theme/palette.toml (template: theme/templates/scripts/ember-bar.py); edit those, not this
YELLOW = "#f0d070"
RED = "#ff6e5e"
GREEN = "#83c995"
CYAN = "#52e6ec"
BLUE = "#6ba5ff"
TEAL = "#4bd3d9"
MAGENTA = "#b87af2"
COMMENT = "#7b8496"
# ember:end

ICON = '<span font_family="Symbols Nerd Font" size="13pt" rise="-1pt" color="{color}">{glyph}</span>'


def show(glyph, icon_color, value, level=0, value_color=None):
    color = value_color or (RED if level == 2 else YELLOW if level == 1 else None)
    text = f'<span color="{color}" weight="bold">{value}</span>' if color else value
    print(ICON.format(color=icon_color, glyph=glyph) + (f" {text}" if text else ""), flush=True)


def level(v, warn, crit):
    return 2 if v >= crit else 1 if v >= warn else 0


def cpu():
    def sample():
        with open("/proc/stat") as f:
            vals = list(map(int, f.readline().split()[1:]))
        return vals[3] + vals[4], sum(vals)  # idle + iowait, total
    idle0, total0 = sample()
    while True:
        time.sleep(2)
        idle1, total1 = sample()
        pct = 100 * (1 - (idle1 - idle0) / max(total1 - total0, 1))
        idle0, total0 = idle1, total1
        show("\U000f0ee0", YELLOW, f"{pct:.0f}%", level(pct, 80, 95))


def gpu():
    # nvidia-smi's own loop keeps one process alive instead of forking every tick
    p = subprocess.Popen(["nvidia-smi", "--query-gpu=temperature.gpu", "--format=csv,noheader,nounits",
                          "--loop-ms=3000"], stdout=subprocess.PIPE, text=True)
    for line in p.stdout:
        t = int(line.strip() or 0)
        show("\U000f08ae", GREEN, f"{t}°", level(t, 80, 85))


def mem():
    while True:
        info = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":", 1)
                info[k] = int(v.split()[0])
        used = info["MemTotal"] - info["MemAvailable"]
        pct = 100 * used / info["MemTotal"]
        show("\U000f035b", CYAN, f"{used / 1048576:.1f}G", level(pct, 80, 95))
        time.sleep(5)


COUCH = os.path.expanduser("~/.local/share/couch")


def vol_target():
    """Where sound goes: "wave" at the desk; on the sofa the couch choice, "pad" or "soundbar".
    Returns (kind, sink) where sink is the controller headset sink for "pad"."""
    try:
        with open(f"{COUCH}/state.json") as f:
            if json.load(f).get("mode") != "sofa":
                return "wave", None
        with open(f"{COUCH}/prefs.json") as f:
            choice = json.load(f).get("sofa_audio", "soundbar")
    except (OSError, ValueError):
        return "wave", None
    if choice != "controller":
        return "soundbar", None
    sinks = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True, text=True).stdout
    return "pad", next((l.split()[1] for l in sinks.splitlines() if "8BitDo" in l), None)


def wave_level():
    # The Wave XLR's headphone level (its dial) is the card's PCM control: 0-120 = -60..0 dB.
    # Everything upstream (OpenXLR channels, default sink) stays at unity, so this is the volume.
    out = subprocess.run(["amixer", "-c", "XLR", "sget", "PCM"], capture_output=True, text=True).stdout
    m = re.search(r"Playback (\d+) \[\d+%\].*\[(on|off)\]", out)
    return (round(int(m.group(1)) * 100 / 120), m.group(2) == "off") if m else (None, False)


def pad_level(sink):
    if not sink:
        return None, False
    vol = subprocess.run(["pactl", "get-sink-volume", sink], capture_output=True, text=True).stdout
    mute = subprocess.run(["pactl", "get-sink-mute", sink], capture_output=True, text=True).stdout
    m = re.search(r"(\d+)%", vol)
    return (int(m.group(1)) if m else None), "yes" in mute


def vol():
    last = None

    def emit():
        nonlocal last
        kind, sink = vol_target()
        if kind == "soundbar":
            args = ("\U000f04c3", MAGENTA, "soundbar")  # level lives on the soundbar (CEC)
        else:
            pct, muted = wave_level() if kind == "wave" else pad_level(sink)
            glyph = "\U000f02cb" if kind == "wave" else "\U000f0297"
            if pct is None:
                args = (glyph, COMMENT, "off", 0, COMMENT)
            elif muted:
                args = ("\U000f07ce" if kind == "wave" else glyph, RED, "muted", 0, RED)
            else:
                args = (glyph, MAGENTA, f"{pct}%")
        if args != last:
            show(*args)
            last = args

    emit()
    # Wake on Wave control changes (dial, mute) and sink changes (controller headset);
    # the 2 s timeout catches couch desk/sofa switches and a Wave that was unplugged.
    sel = selectors.DefaultSelector()
    for cmd in (["stdbuf", "-oL", "alsactl", "monitor", "XLR"], ["pactl", "subscribe"]):
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        sel.register(p.stdout, selectors.EVENT_READ)
    while True:
        for key, _ in sel.select(timeout=2):
            if not key.fileobj.readline():
                sel.unregister(key.fileobj)
        emit()


def vol_step():
    # Scroll/right-click on the volume chip: ember-bar vol-step up|down|mute
    action = sys.argv[2]
    kind, sink = vol_target()
    if kind == "wave":
        step = {"up": "2+", "down": "2-", "mute": "toggle"}[action]  # 2 steps = 1 dB
        subprocess.run(["amixer", "-q", "-c", "XLR", "sset", "PCM", step])
    elif kind == "pad" and sink:
        if action == "mute":
            subprocess.run(["pactl", "set-sink-mute", sink, "toggle"])
        else:
            pct, _ = pad_level(sink)
            new = min(100, max(0, (pct or 0) + (2 if action == "up" else -2)))
            subprocess.run(["pactl", "set-sink-volume", sink, f"{new}%"])


def default_iface():
    with open("/proc/net/route") as f:
        for line in f.readlines()[1:]:
            parts = line.split()
            if parts[1] == "00000000":
                return parts[0]
    return None


def net():
    while True:
        iface = default_iface()
        state = open(f"/sys/class/net/{iface}/operstate").read().strip() if iface else "down"
        if state == "up":
            show("\U000f0200", BLUE, "")
        else:
            show("\U000f0319", RED, "offline", value_color=RED)
        time.sleep(5)


def pad():
    # Xbox-protocol pads (xone/gip) report a battery level, not a percentage
    path = "/sys/class/power_supply/gip0.0/capacity_level"
    while True:
        try:
            lvl = open(path).read().strip().lower()
        except OSError:
            lvl = None
        if lvl is None:
            print("", flush=True)
        else:
            show("\U000f0297", TEAL, lvl, {"low": 1, "critical": 2}.get(lvl, 0))
        time.sleep(10)


def media():
    # Now playing (Spotify first, then any MPRIS player); empty output hides the module.
    # playerctl --follow prints a line per change and an empty one when the player goes.
    print("", flush=True)
    fmt = "{{status}}\t{{artist}}\t{{title}}"
    p = subprocess.Popen(["playerctl", "--player=spotify,%any", "--follow", "metadata", "--format", fmt],
                         stdout=subprocess.PIPE, text=True)
    for line in p.stdout:
        status, artist, title = (line.rstrip("\n").split("\t") + ["", "", ""])[:3]
        if not title or status == "Stopped":
            print("", flush=True)
            continue
        text = f"{artist} – {title}" if artist else title
        text = html.escape(text if len(text) <= 48 else text[:47] + "…")
        if status == "Playing":
            show("\U000f040a", MAGENTA, text)
        else:
            show("\U000f03e4", COMMENT, text, value_color=COMMENT)


if __name__ == "__main__":
    try:
        {"cpu": cpu, "gpu": gpu, "mem": mem, "vol": vol, "vol-step": vol_step, "net": net, "pad": pad, "media": media}[sys.argv[1]]()
    except (BrokenPipeError, KeyboardInterrupt):
        # ironbar closed the pipe (bar reload/exit); leave without a traceback
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
