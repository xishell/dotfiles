{
    "global": {
        "ask_for_confirmation_before_quitting": false,
        "check_for_updates_on_startup": false,
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "complex_modifications": {
                "parameters": {
                    "basic.to_if_alone_timeout_milliseconds": 200,
                    "basic.to_if_held_down_threshold_milliseconds": 200
                },
                "rules": [
                    {
                        "description": "Remap Caps Lock to Ctrl when held, Esc when tapped",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "lazy": true
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Remap Left Option to Ctrl+Alt (for Aerospace, right option untouched for special chars)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "left_option",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_option",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Remap Tab to Hyper key when held, Tab when tapped",
                        "manipulators": [
                            {
                                "from": { "key_code": "tab" },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["any"]
                                    },
                                    {
                                        "set_variable": {
                                            "name": "hyper",
                                            "value": 1
                                        }
                                    }
                                ],
                                "to_after_key_up": [
                                    {
                                        "set_variable": {
                                            "name": "hyper",
                                            "value": 0
                                        }
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "tab" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "virtual_hid_keyboard": {
                "country_code": 0,
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}