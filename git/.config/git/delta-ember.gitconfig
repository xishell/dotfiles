# generated by theme/gen from theme/palette.toml (template: theme/templates/git/delta.gitconfig); edit those, not this
# delta: Tokyo Night Ember (included from ~/.config/git/config). Syntax colours come from
# the bat theme of the same name; added/removed lines get green/red tints over base.
[delta]
    syntax-theme = Ember
    minus-style = syntax "#38252d"
    minus-emph-style = syntax "#5f3641"
    plus-style = syntax "#2b2c28"
    plus-emph-style = syntax "#414937"
    map-styles = bold purple => syntax "#3c3146", bold cyan => syntax "#303b44"
    line-numbers-minus-style = "#f2798c"
    line-numbers-plus-style = "#a7c97a"
    line-numbers-zero-style = "#48404f"
    line-numbers-left-style = "#2a2530"
    line-numbers-right-style = "#2a2530"
    file-style = "#82a1e6" bold
    file-decoration-style = "#2a2530" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#2a2530" box
    hunk-header-file-style = "#82a1e6"
    hunk-header-line-number-style = "#ff9e64"
    commit-style = "#e6b673"
    commit-decoration-style = "#2a2530" box
    blame-palette = "#1a171d" "#141217"
