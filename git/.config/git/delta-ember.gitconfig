# generated by theme/gen from theme/palette.toml (template: theme/templates/git/delta.gitconfig); edit those, not this
# delta: Hearth (included from ~/.config/git/config). Syntax colours come from
# the bat theme of the same name; added/removed lines get green/red tints over base.
[delta]
    syntax-theme = Ember
    minus-style = syntax "#2f1b20"
    minus-emph-style = syntax "#5a2c36"
    plus-style = syntax "#1e2619"
    plus-emph-style = syntax "#364825"
    map-styles = bold purple => syntax "#34263c", bold cyan => syntax "#1b343b"
    line-numbers-minus-style = "#ff6f88"
    line-numbers-plus-style = "#9ee05f"
    line-numbers-zero-style = "#343440"
    line-numbers-left-style = "#19191d"
    line-numbers-right-style = "#19191d"
    file-style = "#7ea2f2" bold
    file-decoration-style = "#19191d" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#19191d" box
    hunk-header-file-style = "#7ea2f2"
    hunk-header-line-number-style = "#ff9a4f"
    commit-style = "#f5c84f"
    commit-decoration-style = "#19191d" box
    blame-palette = "#0d0d0f" "#070708"
