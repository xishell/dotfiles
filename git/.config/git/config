[color "branch"]
    current  = magenta
    local    = default
    remote   = yellow
    upstream = green
    plain    = blue
[color "decorate"]
    HEAD = red
    branch = blue
    tag = yellow
    remoteBranch = magenta
[user]
	email = 26227374+xishell@users.noreply.github.com
	name = XiShell
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILseAsE+/F335EtsqPL/WV3Jo12iGKJuv5QAo5NQEW63
[includeIf "hasconfig:remote.*.url:*gits-15.sys.kth.se*"]
    path = ~/.gitconfig-kth
[include]
    path = ~/.config/git/config.local
[gpg]
	format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[core]
    compression = 9
    whitespace = error
    preloadindex = true
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
[init]
	defaultBranch = main
[push]
    autoSetupRemote = true
    default = current
    followTags = true
[pull]
    default = current
    rebase = true
[branch]
    sort = -committerdate
[tag]
    sort = -taggerdate
[log]
    abbrevCommit = true
    graphColors = blue,yellow,cyan,magenta,green,red
[rebase]
    autoStash = true
    missingCommitsCheck = warn
[rerere]
    enabled = true
[status]
    branch = true
    showStash = true
    showUntrackedFiles = all
[diff]
    context = 3
    renames = copies
    interHunkContext = 10
[url "git@github.com:xishell/"]
    insteadOf = "xi:"
[url "git@github.com:"]
    insteadOf = "gh:"
[url "git@gits-15.sys.kth.se:"]
    insteadOf = "kth:"
