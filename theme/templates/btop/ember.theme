# btop: Hearth. Labels match the bar: cpu yellow, mem cyan, net blue.
theme[main_bg]="{{ base }}"
theme[main_fg]="{{ fg }}"
theme[title]="{{ fg }}"
theme[hi_fg]="{{ primary }}"
theme[selected_bg]="{{ selection }}"
theme[selected_fg]="{{ fg }}"
theme[inactive_fg]="{{ comment }}"
theme[graph_text]="{{ fg_dim }}"
theme[meter_bg]="{{ surface }}"
theme[proc_misc]="{{ magenta }}"
theme[cpu_box]="{{ overlay }}"
theme[mem_box]="{{ overlay }}"
theme[net_box]="{{ overlay }}"
theme[proc_box]="{{ overlay }}"
theme[div_line]="{{ surface }}"
theme[temp_start]="{{ green }}"
theme[temp_mid]="{{ yellow }}"
theme[temp_end]="{{ red }}"
theme[cpu_start]="{{ yellow | mix:base:0.6 }}"
theme[cpu_mid]="{{ yellow }}"
theme[cpu_end]="{{ red }}"
theme[free_start]="{{ green | mix:base:0.6 }}"
theme[free_mid]="{{ green }}"
theme[free_end]="{{ green }}"
theme[cached_start]="{{ blue | mix:base:0.6 }}"
theme[cached_mid]="{{ blue }}"
theme[cached_end]="{{ blue }}"
theme[available_start]="{{ cyan | mix:base:0.6 }}"
theme[available_mid]="{{ cyan }}"
theme[available_end]="{{ cyan }}"
theme[used_start]="{{ cyan | mix:base:0.6 }}"
theme[used_mid]="{{ cyan }}"
theme[used_end]="{{ red }}"
theme[download_start]="{{ blue | mix:base:0.6 }}"
theme[download_mid]="{{ blue }}"
theme[download_end]="{{ cyan }}"
theme[upload_start]="{{ magenta | mix:base:0.6 }}"
theme[upload_mid]="{{ magenta }}"
theme[upload_end]="{{ orange }}"
theme[process_start]="{{ green }}"
theme[process_mid]="{{ yellow }}"
theme[process_end]="{{ red }}"
