# generated by theme/gen from theme/palette.toml (template: theme/templates/zsh/prompt.zsh); edit those, not this
# pure prompt colours (Hearth): dir blue, branch magenta, ❯ green / red on error
zstyle :prompt:pure:path                  color '#7ea2f2'
zstyle :prompt:pure:git:branch            color '#cf8cf2'
zstyle :prompt:pure:git:branch:cached     color '#ff6f88'
zstyle :prompt:pure:git:dirty             color '#f5c84f'
zstyle :prompt:pure:git:arrow             color '#52cfec'
zstyle :prompt:pure:git:stash             color '#52cfec'
zstyle :prompt:pure:git:action            color '#f5c84f'
zstyle :prompt:pure:prompt:success        color '#9ee05f'
zstyle :prompt:pure:prompt:error          color '#ff6f88'
zstyle :prompt:pure:prompt:continuation   color '#83838c'
zstyle :prompt:pure:execution_time        color '#f5c84f'
zstyle :prompt:pure:user                  color '#83838c'
zstyle :prompt:pure:user:root             color '#ff6f88'
zstyle :prompt:pure:host                  color '#83838c'
zstyle :prompt:pure:virtualenv            color '#83838c'
zstyle :prompt:pure:suspended_jobs        color '#ff6f88'

# One line: pure joins its path/git line and the ❯ line with $prompt_newline; an empty
# expansion (%666v, an unset psvar) plus a space puts them side by side
prompt_newline='%666v '

# No blank line between commands: pure prints one before every prompt (a bare `print` in
# prompt_pure_preprompt_render, no option for it), so mute argument-less print while it runs
if (( $+functions[prompt_pure_preprompt_render] )); then
    functions[_ember_pure_preprompt_render]=$functions[prompt_pure_preprompt_render]
    prompt_pure_preprompt_render() {
        print() { (( $# )) && builtin print "$@" }
        _ember_pure_preprompt_render "$@"
        local ret=$?
        unfunction print
        return ret
    }
fi
