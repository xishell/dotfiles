# generated by theme/gen from theme/palette.toml (template: theme/templates/zsh/prompt.zsh); edit those, not this
# pure prompt colours (Tokyo Night Ember): dir blue, branch magenta, ❯ green / red on error
zstyle :prompt:pure:path                  color '#82a1e6'
zstyle :prompt:pure:git:branch            color '#c49ae8'
zstyle :prompt:pure:git:branch:cached     color '#f2798c'
zstyle :prompt:pure:git:dirty             color '#e6b673'
zstyle :prompt:pure:git:arrow             color '#86c9e0'
zstyle :prompt:pure:git:stash             color '#86c9e0'
zstyle :prompt:pure:git:action            color '#e6b673'
zstyle :prompt:pure:prompt:success        color '#a7c97a'
zstyle :prompt:pure:prompt:error          color '#f2798c'
zstyle :prompt:pure:prompt:continuation   color '#938a9b'
zstyle :prompt:pure:execution_time        color '#e6b673'
zstyle :prompt:pure:user                  color '#938a9b'
zstyle :prompt:pure:user:root             color '#f2798c'
zstyle :prompt:pure:host                  color '#938a9b'
zstyle :prompt:pure:virtualenv            color '#938a9b'
zstyle :prompt:pure:suspended_jobs        color '#f2798c'
