# generated by theme/gen from theme/palette.toml (template: theme/templates/zsh/prompt.zsh); edit those, not this
# pure prompt colours: dir cyan, branch purple, ❯ green / red on error
zstyle :prompt:pure:path                  color '#52e6ec'
zstyle :prompt:pure:git:branch            color '#b87af2'
zstyle :prompt:pure:git:branch:cached     color '#ff6e5e'
zstyle :prompt:pure:git:dirty             color '#f0d070'
zstyle :prompt:pure:git:arrow             color '#52e6ec'
zstyle :prompt:pure:git:stash             color '#52e6ec'
zstyle :prompt:pure:git:action            color '#f0d070'
zstyle :prompt:pure:prompt:success        color '#83c995'
zstyle :prompt:pure:prompt:error          color '#ff6e5e'
zstyle :prompt:pure:prompt:continuation   color '#7b8496'
zstyle :prompt:pure:execution_time        color '#f0d070'
zstyle :prompt:pure:user                  color '#7b8496'
zstyle :prompt:pure:user:root             color '#ff6e5e'
zstyle :prompt:pure:host                  color '#7b8496'
zstyle :prompt:pure:virtualenv            color '#7b8496'
zstyle :prompt:pure:suspended_jobs        color '#ff6e5e'

# One line: pure joins its path/git line and the ❯ line with $prompt_newline; an empty
# expansion (%666v, an unset psvar) plus a space puts them side by side
prompt_newline='%666v '

# No blank line between commands: pure prints one before every prompt (a bare `print` in
# prompt_pure_preprompt_render, no option for it), so mute argument-less print while it runs
if (( $+functions[prompt_pure_preprompt_render] )); then
    functions[_ember_pure_preprompt_render]=$functions[prompt_pure_preprompt_render]
    prompt_pure_preprompt_render() {
        print() { (( $# )) && builtin print "$@" }
        _ember_pure_preprompt_render "$@"
        local ret=$?
        unfunction print
        return ret
    }
fi
