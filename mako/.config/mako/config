# generated by theme/gen from theme/palette.toml (template: theme/templates/mako/config); edit those, not this
# mako: Tokyo Night Ember. 380 wide, top right under the bar, 10 from the edges,
# 8 between cards, radius 10, padding 12 14, 1 px overlay border, 5 s timeout.
# App line (dim) / bold title / body (fg_dim).

font=FiraCode Nerd Font 10
anchor=top-right
layer=overlay
outer-margin=10
margin=0,0,8,0
padding=12,14
width=380
border-size=1
border-radius=10
icons=1
max-icon-size=40
default-timeout=5000
max-visible=4

background-color=#1a171d
text-color=#ddd3d6
border-color=#48404f
progress-color=over #3a3342
format=<span size="small" color="#938a9b">%a</span>\n<b>%s</b>\n<span color="#b3a9b8">%b</span>

[urgency=low]
border-color=#2a2530

[urgency=critical]
border-size=2
border-color=#f2798c
default-timeout=0
format=<span size="small" color="#f2798c">%a · critical</span>\n<b>%s</b>\n<span color="#b3a9b8">%b</span>

# Couch/desk switches (couch.py)
[app-name=couch]
border-size=2
border-color=#ff9e64
format=<span size="small" color="#ff9e64">%a</span>\n<b>%s</b>\n<span color="#b3a9b8">%b</span>

# Fingerprint prompt from the sudo PAM hook (/usr/local/bin/fprint-notify)
[app-name=fingerprint]
border-size=2
border-color=#e6b673
anchor=top-center
