# generated by theme/gen from theme/palette.toml (template: theme/templates/mako/config); edit those, not this
# mako: Hearth. 380 wide, top right under the bar, 10 from the edges,
# 8 between cards, radius 10, padding 12 14, 1 px overlay border, 5 s timeout.
# App line (dim) / bold title / body (fg_dim).

font=FiraCode Nerd Font 10
anchor=top-right
layer=overlay
outer-margin=10
margin=0,0,8,0
padding=12,14
width=380
border-size=1
border-radius=10
icons=1
max-icon-size=40
default-timeout=5000
max-visible=4
max-history=50

background-color=#0d0d0f
text-color=#eceaf2
border-color=#343440
progress-color=over #151519
format=<span size="small" color="#83838c">%a</span>\n<b>%s</b>\n<span color="#c0c0c8">%b</span>

[urgency=low]
border-color=#19191d

[urgency=critical]
border-size=2
border-color=#ff6f88
default-timeout=0
format=<span size="small" color="#ff6f88">%a · critical</span>\n<b>%s</b>\n<span color="#c0c0c8">%b</span>

# Couch/desk switches (couch.py)
[app-name=couch]
border-size=2
border-color=#cf8cf2
format=<span size="small" color="#cf8cf2">%a</span>\n<b>%s</b>\n<span color="#c0c0c8">%b</span>

# Fingerprint prompt from the sudo PAM hook (/usr/local/bin/fprint-notify)
[app-name=fingerprint]
border-size=2
border-color=#f5c84f
anchor=top-center

# Do not disturb (Super+N, bell on the bar; `notif dnd`): hide everything except
# critical notifications and the sudo fingerprint prompt. Hidden ones still land in
# the history (Super+Shift+N).
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0

[mode=do-not-disturb app-name=fingerprint]
invisible=0
