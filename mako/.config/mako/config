# generated by theme/gen from theme/palette.toml (template: theme/templates/mako/config); edit those, not this
# mako: Hearth. 380 wide, top right under the bar, 10 from the edges,
# 8 between cards, radius 10, padding 12 14, 1 px overlay border, 5 s timeout.
# App line (dim) / bold title / body (fg_dim).

font=FiraCode Nerd Font 10
anchor=top-right
layer=overlay
outer-margin=10
margin=0,0,8,0
padding=12,14
width=380
border-size=1
border-radius=10
icons=1
max-icon-size=40
default-timeout=5000
max-visible=4
max-history=50

background-color=#16181a
text-color=#e2e4ea
border-color=#3c4048
progress-color=over #22252b
format=<span size="small" color="#7b8496">%a</span>\n<b>%s</b>\n<span color="#b6bac3">%b</span>

[urgency=low]
border-color=#2a2d33

[urgency=critical]
border-size=2
border-color=#ff6e5e
default-timeout=0
format=<span size="small" color="#ff6e5e">%a · critical</span>\n<b>%s</b>\n<span color="#b6bac3">%b</span>

# Couch/desk switches (couch.py)
[app-name=couch]
border-size=2
border-color=#6ba5ff
format=<span size="small" color="#6ba5ff">%a</span>\n<b>%s</b>\n<span color="#b6bac3">%b</span>

# Fingerprint prompt from the sudo PAM hook (/usr/local/bin/fprint-notify)
[app-name=fingerprint]
border-size=2
border-color=#f0d070
anchor=top-center

# Do not disturb (Super+N, bell on the bar; `notif dnd`): hide everything except
# critical notifications and the sudo fingerprint prompt. Hidden ones still land in
# the history (Super+Shift+N).
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0

[mode=do-not-disturb app-name=fingerprint]
invisible=0
